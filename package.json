{
	"name": "@cloudfour/eslint-config",
	"version": "26.0.0",
	"description": "Cloud Four's shareable ESLint configuration",
	"license": "MIT",
	"repository": "github:cloudfour/eslint-config",
	"homepage": "https://github.com/cloudfour/eslint-config",
	"bugs": "https://github.com/cloudfour/eslint-config/issues",
	"author": "Cloud Four <info@cloudfour.com> (http://cloudfour.com)",
	"type": "module",
	"exports": "./eslint.config.js",
	"sideEffects": false,
	"engines": {
		"node": "^22.13.0 || >=24"
	},
	"scripts": {
		"lint": "npm run lint:js && npm run lint:prettier",
		"lint:check": "npm run lint:js:check && npm run lint:prettier:check",
		"lint:js": "eslint --fix . --ignore-pattern \"__tests__/fixtures/**\"",
		"lint:js:check": "eslint . --ignore-pattern \"__tests__/fixtures/**\"",
		"lint:prettier": "prettier --write .",
		"lint:prettier:check": "prettier --check .",
		"test": "node --test",
		"test:watch": "node --test --watch"
	},
	"files": [
		"eslint.config.js"
	],
	"keywords": [
		"eslint",
		"eslintconfig"
	],
	"dependencies": {
		"eslint-config-xo": "1.0.0",
		"eslint-plugin-promise": "7.3.0",
		"globals": "17.11.0"
	},
	"devDependencies": {
		"eslint": "10.9.1",
		"prettier": "3.9.6",
		"semver": "7.8.5",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"eslint": "^10.6.0"
	},
	"prettier": {
		"singleQuote": true
	}
}
